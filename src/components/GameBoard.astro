<div class="board-wrapper glass-panel">
  <div class="svg-container">
    <svg id="game-svg" viewBox="0 0 600 600" preserveAspectRatio="xMidYMid meet">
      <!-- SVG dynamic elements generated by JS -->
      <g id="boxes-group"></g>
      <g id="lines-group"></g>
      <g id="dots-group"></g>
    </svg>
  </div>
</div>

<style>
  .board-wrapper {
    width: 100%;
    max-width: 580px;
    margin: 0 auto;
    padding: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    user-select: none;
    touch-action: manipulation;
  }

  .svg-container {
    width: 100%;
    aspect-ratio: 1 / 1;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #game-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* SVG Line Styles */
  :global(.board-line) {
    cursor: pointer;
    transition: stroke var(--transition-fast), stroke-width var(--transition-fast), opacity var(--transition-fast);
  }

  :global(.board-line.empty) {
    stroke: var(--line-empty);
    stroke-linecap: round;
  }

  :global(.board-line.hovered) {
    stroke: var(--line-hover);
    stroke-width: 8px;
  }

  :global(.board-line.claimed-p1) {
    stroke: var(--player1-color);
    filter: drop-shadow(0 0 6px var(--player1-glow));
    stroke-width: 8px;
    stroke-linecap: round;
  }

  :global(.board-line.claimed-p2) {
    stroke: var(--player2-color);
    filter: drop-shadow(0 0 6px var(--player2-glow));
    stroke-width: 8px;
    stroke-linecap: round;
  }

  :global(.board-line.last-move) {
    animation: pulseLine 1.5s infinite alternate;
  }

  :global(.board-line.hint) {
    stroke: var(--accent-gold) !important;
    stroke-width: 10px !important;
    animation: hintPulse 0.8s infinite alternate;
  }

  @keyframes pulseLine {
    0% { stroke-width: 7px; filter: brightness(1); }
    100% { stroke-width: 10px; filter: brightness(1.4) drop-shadow(0 0 12px currentColor); }
  }

  @keyframes hintPulse {
    0% { opacity: 0.4; }
    100% { opacity: 1; filter: drop-shadow(0 0 14px var(--accent-gold)); }
  }

  /* SVG Box Styles */
  :global(.board-box) {
    transition: fill var(--transition-normal), opacity var(--transition-normal);
  }

  :global(.board-box.p1-box) {
    fill: var(--player1-bg);
  }

  :global(.board-box.p2-box) {
    fill: var(--player2-bg);
  }

  :global(.box-label) {
    font-family: var(--font-family);
    font-weight: 800;
    font-size: 20px;
    text-anchor: middle;
    dominant-baseline: central;
    pointer-events: none;
    opacity: 0.95;
    transition: opacity var(--transition-normal);
  }

  :global(.box-label.p1-text) {
    fill: var(--player1-color);
  }

  :global(.box-label.p2-text) {
    fill: var(--player2-color);
  }

  /* SVG Dot Styles */
  :global(.board-dot) {
    fill: var(--dot-color);
    transition: fill var(--transition-normal), transform var(--transition-normal);
  }

  :global(.board-dot.active) {
    fill: var(--dot-active);
    filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.8));
  }

  @media (max-width: 600px) {
    .board-wrapper {
      padding: 12px;
      margin: 0;
    }
  }
</style>
