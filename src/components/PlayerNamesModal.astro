---
---
<div id="player-names-modal" class="modal-overlay active">
  <div class="modal-content player-names-card">
    <div class="modal-header">
      <h2 id="names-modal-title" class="modal-title">🎮 Welcome to BoxBattle</h2>
    </div>

    <p id="names-modal-desc" class="modal-description">Enter your name to begin. The game starts only after you confirm.</p>

    <div class="name-inputs-container">
      <div class="input-group p1-input-group">
        <label for="p1-name-input">
          <span class="player-dot p1-dot"></span> Your Name
        </label>
        <input type="text" id="p1-name-input" class="name-input" placeholder="Player 1" maxlength="16" value="Player 1" autocomplete="off" />
      </div>

      <div id="p2-name-group" class="input-group p2-input-group" style="display:none">
        <label for="p2-name-input">
          <span class="player-dot p2-dot"></span> Player 2 Name
        </label>
        <input type="text" id="p2-name-input" class="name-input p2" placeholder="Player 2" maxlength="16" value="Player 2" autocomplete="off" />
      </div>
    </div>

    <div class="modal-footer">
      <button id="start-2p-btn" class="btn btn-primary btn-lg">
        Let's Play 🚀
      </button>
    </div>
  </div>
</div>

<style>
  .player-names-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .modal-title {
    font-size: 1.4rem;
    font-weight: 800;
  }

  .modal-description {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .name-inputs-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .input-group label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-main);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .player-dot {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    display: inline-block;
  }

  .p1-dot {
    background: var(--player1-color);
  }

  .p2-dot {
    background: var(--player2-color);
  }

  .name-input {
    width: 100%;
    padding: 12px 16px;
    font-size: 1rem;
    font-weight: 600;
    font-family: inherit;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    outline: none;
    transition: border-color var(--transition-normal), box-shadow var(--transition-normal);
    box-sizing: border-box;
  }

  .name-input:focus {
    border-color: var(--player1-color);
    box-shadow: 0 0 12px var(--player1-glow);
  }

  .name-input.p2:focus {
    border-color: var(--player2-color);
    box-shadow: 0 0 12px var(--player2-glow);
  }

  .btn-lg {
    width: 100%;
    padding: 12px;
    font-size: 1.05rem;
  }
</style>
