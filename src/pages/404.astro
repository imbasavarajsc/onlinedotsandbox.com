---
import Layout from '../layouts/Layout.astro';
import SubpageHeader from '../components/SubpageHeader.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="404 - Page Not Found | BoxBattle"
  description="The requested page could not be found. Return to BoxBattle and play Dots and Boxes online."
  url="https://dotsandboxesgame.com/404"
>
  <div class="subpage-wrapper">
    <SubpageHeader />

    <main class="content-container">
      <div class="error-card glass-panel">
        <!-- Broken Grid Visual Animation -->
        <div class="error-visual">
          <svg width="180" height="180" viewBox="0 0 160 160" fill="none" class="error-svg">
            <!-- Background Dot Matrix -->
            <circle cx="30" cy="30" r="5" fill="var(--player1-color)" class="pulse-dot" />
            <circle cx="80" cy="30" r="5" fill="var(--player1-color)" />
            <circle cx="130" cy="30" r="5" fill="var(--dot-color)" />

            <circle cx="30" cy="80" r="5" fill="var(--player2-color)" />
            <circle cx="80" cy="80" r="6" fill="#f59e0b" class="alert-dot" />
            <circle cx="130" cy="80" r="5" fill="var(--dot-color)" />

            <circle cx="30" cy="130" r="5" fill="var(--dot-color)" />
            <circle cx="80" cy="130" r="5" fill="var(--dot-color)" />
            <circle cx="130" cy="130" r="5" fill="var(--player2-color)" class="pulse-dot-p2" />

            <!-- Connecting & Broken Lines -->
            <line x1="30" y1="30" x2="80" y2="30" stroke="var(--player1-color)" stroke-width="4" stroke-linecap="round" />
            <line x1="30" y1="30" x2="30" y2="80" stroke="var(--player2-color)" stroke-width="4" stroke-linecap="round" />
            <line x1="80" y1="30" x2="80" y2="80" stroke="var(--line-empty)" stroke-dasharray="4 4" stroke-width="3" />
            <line x1="30" y1="80" x2="80" y2="80" stroke="var(--player2-color)" stroke-width="4" stroke-linecap="round" />
            
            <!-- Question Mark in unclosed Box -->
            <text x="55" y="62" font-size="22" font-weight="900" fill="#f59e0b" text-anchor="middle" font-family="Outfit, sans-serif">?</text>
          </svg>
        </div>

        <div class="error-badge">404 Error</div>
        <h1 class="error-title">Out of Bounds!</h1>
        <p class="error-message">
          Looks like this line didn't connect to any box. The page you are looking for has moved, expired, or doesn’t exist on our game grid.
        </p>

        <div class="quick-links-panel">
          <a href="/" class="btn btn-primary btn-lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            Play Dots and Boxes
          </a>
          <a href="/about" class="btn">About the Game</a>
          <a href="/contact" class="btn">Report an Issue</a>
        </div>
      </div>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .subpage-wrapper {
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .content-container {
    width: 100%;
    max-width: 800px;
    padding: 3rem 1.5rem 5rem 1.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    flex: 1;
  }

  .error-card {
    width: 100%;
    padding: 3.5rem 2.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    position: relative;
    overflow: hidden;
  }

  .error-visual {
    margin-bottom: 0.5rem;
  }

  .error-svg {
    filter: drop-shadow(0 0 20px rgba(56, 189, 248, 0.2));
  }

  .pulse-dot {
    animation: glowPulse 2s infinite ease-in-out;
  }

  .pulse-dot-p2 {
    animation: glowPulseP2 2s infinite ease-in-out 1s;
  }

  .alert-dot {
    animation: alertPulse 1.5s infinite alternate;
  }

  @keyframes glowPulse {
    0%, 100% { filter: drop-shadow(0 0 2px var(--player1-color)); }
    50% { filter: drop-shadow(0 0 10px var(--player1-color)); }
  }

  @keyframes glowPulseP2 {
    0%, 100% { filter: drop-shadow(0 0 2px var(--player2-color)); }
    50% { filter: drop-shadow(0 0 10px var(--player2-color)); }
  }

  @keyframes alertPulse {
    0% { transform: scale(1); }
    100% { transform: scale(1.3); }
  }

  .error-badge {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--accent-gold);
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.3);
    padding: 4px 14px;
    border-radius: var(--radius-full);
  }

  .error-title {
    font-size: 2.8rem;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .error-message {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #cbd5e1;
    max-width: 520px;
  }

  .quick-links-panel {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1rem;
    width: 100%;
  }

  .btn-lg {
    padding: 12px 24px;
    font-size: 1.05rem;
  }

  @media (max-width: 640px) {
    .error-card {
      padding: 2.5rem 1.25rem;
    }

    .error-title {
      font-size: 2rem;
    }

    .quick-links-panel {
      flex-direction: column;
      width: 100%;
    }

    .quick-links-panel .btn {
      width: 100%;
    }
  }
</style>
